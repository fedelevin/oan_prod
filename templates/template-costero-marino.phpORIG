get_header(); ?>
<?php global $theme_; ?>

	<main role="main">
		<!-- section -->
		<section class="container-fluid background-container">	

			<?php if (have_posts()): while (have_posts()) : the_post(); ?>

				<!-- Encabezado -->
				<?php if($theme_['encabezados_switch'] == 1){ ?>
				<div id="slide-" class="slide-">
		        	<?php foreach ($theme_['encabezado'] as $slide => $property){ ?>

		        		<?php if($property['title'] == get_the_title()){ ?>

							<img class="img-responsive center-block" src="<?php echo get_template_directory_uri(); ?>/images/Shadow6-.png">
							<div class="col-md-8">
								<img class="img-responsive" src="<?php echo $property['image']; ?>">
							</div>
							<div class="col-md-4">
								<h2 class="title_line"><span><?php the_title(); ?></span></h2>				
								<p><?php echo $property['description']; ?></p>
								<?php if($property['url'] != "") {?>
								<a href="#" data-toggle="modal" data-target="#exampleModalLong"><i class="fa fa-plus-circle fa-2x" aria-hidden="true"></i></a>
								<?php } ?>
							</div>
							<img class="img-responsive center-block" src="<?php echo get_template_directory_uri(); ?>/images/Shadow6.png">

		        		<?php } ?>

					<?php } ?>
				</div>
				<?php } ?>
				<!-- Encabezado -->

				<!-- Modal -->
				<div class="modal fade" id="exampleModalLong" tabindex="-1" role="dialog" aria-labelledby="exampleModalLongTitle" aria-hidden="true">
				  <div class="modal-dialog modal-lg" role="document">
				    <div class="modal-content">
				      <div class="modal-header">
				        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
				          	<span aria-hidden="true">&times;</span>
				        </button>        
				        <?php the_post_thumbnail(); ?>
			        	<h2 class="title_line"> <span><?php ?><?php the_title(); ?></span></h2>
				      </div>
				      <div class="modal-body">
				      <p><?php the_content(); ?></p>
				      </div>
				      <div class="modal-footer">
				        <button type="button" class="btn btn-green-light" data-dismiss="modal">Cerrar</button>
				      </div>
				    </div>
				  </div>
				</div>
				<!-- Modal -->

			<?php endwhile; ?>
			<?php endif; ?>


			<!-- Content -->
		    <?php 
		    	$class_search = $theme_['costero_marino_columns'];
				if($class_search == 1){
					$col = '12';
				}elseif($class_search == 2){
					$col = '6';				
				}elseif($class_search == 3){
					$col = '4';			
				}elseif($class_search == 4){
					$col = '3';
				}elseif($class_search == 6){
					$col = '2';
				}elseif($class_search == 12){
					$col = '1';
				}
				//$link = $property['url'];
		    ?>


			<!-- Geoportal -->
			<article id="post-<?php the_ID(); ?>" <?php post_class(); ?>>
				<?php 
					
					/*
					foreach ($theme_['datos_abiertos_logo'] as $slide => $property){ 
						$title = get_the_title();
						if($property['title'] == $title){
				?>
							
				<?php 
						}
					}
				?>
 				<div class="col-md-12">
					<h1 class="title_line text-center"><span><?php the_title(); ?></span></h1>
				</div>
				<?php
				*/
				?>
				
				
				<div class="col-md-12-">

	        	<?php foreach ($theme_['costero_marino'] as $slide => $property){ ?>

	        		<?php 
	        			$valor = $property['url']; 
	        			$parts = explode("*", $valor); 
	        			//echo $icon = $parts[1]; 
	        			if($parts[2]==""){
	        				$col2 = '4';
	        			}else{
	        				$col2 = '4';
	        			}
	        		?>

					<!-- Boxed -->
					<div class="icons col-md-<?php echo $col; ?>">						
						<div class="box-costero-marino">					
							
							<img class="img-responsive center-block" src="<?php $valor = $property['url']; $parts = explode("*", $valor); echo $icon = $parts[1]; ?>">


							<h2 class="title_line text-center"><span><?php echo $property['title']; ?></span></h2>									
							<div class="minheight-ac">
								<p><?php echo $property['description']; ?></p>									
							</div>
						
							<img class="img-responsive center-block" width="100" src="<?php echo $property['image']; ?>">

							<div class="icons col-md-<?php echo $col2; ?>">	

							<a href="<?php $valor = $property['url']; $parts = explode("*", $valor); echo $redirect = $parts[0]; ?>" data-balloon="Ver" data-balloon-pos="right" class="fullwidth btn btn-green-light center-block link" >
								<i class="fa fa-eye" aria-hidden="true"></i>					
							</a>	

							<?php if($property['title'] == 'Banderas Sanitarias'){?>
											

									<?php if($parts[3]!=""){?>
										<a href="<?php $valor = $property['url']; $parts = explode("*", $valor); echo $redirect = $parts[3]; ?>" data-balloon="Ver gráfico" data-balloon-pos="right" class="fullwidth btn btn-green-light center-block link">
											<i class="fa fa-pie-chart" aria-hidden="true"></i>												
										</a>																		
									<?php } ?>
									

									<?php if($parts[2]!=""){?>

										<a href="<?php 
											$valor = $property['url']; 
											$parts = explode("*", $valor); 
											echo $redirect = $parts[2]; 
											$extension = explode(".", $parts[2]); 
											$extension = end( $extension );
											?>"
											data-balloon="Ver/Descargar PDF" 
											data-balloon-pos="right" class="<?php if ($extension == "pdf"){echo "fullwidth";} ?> btn btn-green-light center-block link">
											<i class="fa fa-download" aria-hidden="true"></i>								
										</a>

									<?php } ?>



							<?php } ?>	

							</div>									
								
						</div>						
					</div>
					<!--// Boxed -->

				<?php } ?>
				</div>

				<br class="clear">
			</article>
			<!-- /Geoportal -->
		</section>
		<!-- /section -->
	</main>





